# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-with-at-least-50-random-characters-for-jwt-signing
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Local dev (config.settings.development): SQLite when USE_SQLITE=true (default).
USE_SQLITE=true
# Production / optional Postgres in dev when USE_SQLITE=false:
DATABASE_URL=postgres://beatiq:beatiq@localhost:5432/beatiq
# Or discrete vars (used if DATABASE_URL unset):
POSTGRES_DB=beatiq
POSTGRES_USER=beatiq
POSTGRES_PASSWORD=beatiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# CORS (comma-separated origins for Flutter/web clients)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL used in emails if request URL cannot be inferred (e.g. some workers)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# JWT lifetimes (optional overrides — seconds)
ACCESS_TOKEN_LIFETIME_SECONDS=3600
REFRESH_TOKEN_LIFETIME_SECONDS=604800

# When true, /auth/token/ rejects users with unverified email
REQUIRE_EMAIL_VERIFICATION_FOR_JWT=False

# Email verification link TTL (seconds)
EMAIL_VERIFICATION_TOKEN_MAX_AGE_SECONDS=259200

# Outbound email
DEFAULT_FROM_EMAIL=BeatIQ <noreply@localhost>

# Production SMTP (used when DJANGO_SETTINGS_MODULE=config.settings.production)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Celery (async tasks: verification email, AI stubs)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_TIME_LIMIT=300

# Cloud storage (placeholders — wire real keys in deployment)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
GOOGLE_CLOUD_STORAGE_BUCKET_NAME=

# External AI vendors (never commit real secrets)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# Compliance
AUDIT_LOG_RETENTION_DAYS=365

# Local superuser helper: python manage.py beatiq_createsuperuser
BEATIQ_SUPERUSER_EMAIL=admin@localhost
BEATIQ_SUPERUSER_PASSWORD=adminchangeme
BEATIQ_SUPERUSER_USERNAME=admin

# Health JSON version string
BEATIQ_API_VERSION=1
